---
import "../styles/global.css";
import { CONTACTS } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "夏至未至",
  description = "用照片记录走过的路、看过的风景和日常的瞬间。",
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

// 极简导航(PRD V1.2:网站名称 + 首页/项目/关于)
const nav = [
  { href: "/", label: "首页", match: (p: string) => p === "/" },
  { href: "/projects/", label: "项目", match: (p: string) => p.startsWith("/projects") },
  { href: "/about/", label: "关于", match: (p: string) => p.startsWith("/about") },
];

// 页脚联系方式:只渲染 href 填过的条目(在 src/config.ts 里改)
const contacts = CONTACTS.filter((c) => c.href.trim());
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- 主题初始化:渲染前设置 html.dark,防闪烁。默认浅色,用户手动切换后记忆(PRD V1.2 需支持暗色切换) -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        if (t === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
    <!-- 兜底:.photo-tile img 初始 opacity:0,靠页尾脚本加 .is-loaded 显形。
         禁用 JS 时不加这一条,整站照片会全部不可见。 -->
    <noscript>
      <style>
        .photo-tile img {
          opacity: 1;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="mx-auto w-full max-w-5xl px-5">
      <div class="flex items-baseline justify-between py-10">
        <a href="/" class="text-base font-medium tracking-wide">夏至未至</a>
        <nav class="flex items-center gap-6">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "text-sm transition-colors",
                  item.match(pathname)
                    ? "font-medium text-ink underline underline-offset-4 decoration-terra/60 dark:text-neutral-100"
                    : "text-mist",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <!-- 主题切换:太阳(浅色模式显示,点击进暗色)/ 月亮(暗色模式显示,点击回浅色) -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="切换深浅主题"
            class="text-mist transition-colors hover:text-ink dark:hover:text-neutral-100"
          >
            <svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-5xl px-5 pt-20 pb-12">
      <div class="flex flex-col items-center gap-4 border-t border-neutral-200/80 pt-8 dark:border-neutral-800">
        {
          contacts.length > 0 && (
            <div class="flex gap-6 text-xs text-mist">
              {contacts.map((c) => (
                <a
                  href={c.href}
                  target={c.external ? "_blank" : undefined}
                  rel={c.external ? "noopener" : undefined}
                  class="transition-colors hover:text-ink dark:hover:text-neutral-100"
                >
                  {c.label}
                </a>
              ))}
            </div>
          )
        }
        <p class="text-xs text-mist/70">© 2026 夏至未至</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var dark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", dark ? "dark" : "light");
        });
      })();
    </script>

    <!-- 图片淡入:瓦片解码完成后由 opacity 0 过渡到 1(占位底色见 global.css .photo-tile) -->
    <script is:inline>
      (function () {
        function mark(img) {
          img.classList.add("is-loaded");
        }
        document.querySelectorAll(".photo-tile img").forEach(function (img) {
          // 已在缓存中的图不会再触发 load,直接判定
          if (img.complete && img.naturalWidth > 0) {
            mark(img);
            return;
          }
          img.addEventListener("load", function () { mark(img); }, { once: true });
          // 加载失败也显示,避免瓦片永远停在占位底色上
          img.addEventListener("error", function () { mark(img); }, { once: true });
        });
      })();
    </script>
  </body>
</html>
