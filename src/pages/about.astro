---
// 关于我:个人介绍与摄影历程(PRD V1.1 §4.5)
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="关于 · 夏至未至">
  <section class="mx-auto w-full max-w-3xl px-5 py-10">
    <!-- TODO: 放入你的肖像/拍摄中的身影照片,并取消下面的注释
    <Image
      src={resolveImage("your-portrait.jpg")}
      alt="我的身影"
      width={900}
      format="webp"
      class="mb-14 h-auto w-full max-w-sm"
    />
    -->

    <h1 class="text-2xl font-light tracking-wide dark:text-neutral-100">关于</h1>

    <div class="story mt-8 text-[15px]">
      <!-- TODO: 替换为你的自我介绍 -->
      <!-- 中文句间不换行:模板中换行会渲染为空格,故两句写在同一行 -->
      <p>你好，我是夏至未至。不求画面有多惊艳，只想留住那些稍纵即逝的瞬间：山雨初歇，湖面风起，林间生灵蓦然回首。</p>
      <p>这个网站收集我拍下的风景、城市与日常。每一个项目，是一段时间的存档。</p>
    </div>

    <h2 class="mt-14 text-base font-medium dark:text-neutral-100">常用器材</h2>
    <!-- TODO: 替换为你的真实器材清单 -->
    <ul class="mt-4 space-y-2 text-sm text-mist">
      <li>尼康</li>
      <li>Z24-200mm</li>
    </ul>

    <div class="mt-16 border-t border-neutral-200/80 pt-6 text-xs text-mist dark:border-neutral-800">
      <p>联系方式见页脚 · 也欢迎在 Instagram / 小红书找到我</p>
    </div>
  </section>
</BaseLayout>
