---
// 首页(PRD V1.2):顶部全宽 Hero 轮播 + 下方 12 张精选墙。
//
// Hero:照片来自独立集合 src/content/featured/(单独路径便于维护),
//       铺满屏幕,点击左/右半区淡入淡出切换,首屏图高优先级加载。
// 精选墙:photos 里带 featured: true 的最新 12 张,保留原始比例(瀑布流,不裁切),
//       悬停显示跟随鼠标的光晕;点击打开灯箱,在这 12 张之间左右切换。
// (V1.1 的"3 天自动轮换"已按 V1.2 移除)
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { cloudinaryUrl } from "../lib/images";

const heroes = (await getCollection("featured")).sort((a, b) =>
  (b.data.date ?? "").localeCompare(a.data.date ?? ""),
);

const picks = (await getCollection("photos"))
  .filter((p) => p.data.featured === true)
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""))
  .slice(0, 12);

const heroCount = heroes.length;
---

<BaseLayout>
  {
    heroCount > 0 && (
      <section class="relative h-[85vh] w-full overflow-hidden bg-neutral-100 dark:bg-neutral-900">
        {
          heroes.map((h, i) => (
            <img
              class:list={[
                "hero-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-700 ease-in-out",
                i === 0 ? "opacity-100" : "opacity-0",
              ]}
              src={cloudinaryUrl(h.data.filename, 1600)}
              alt={h.data.alt ?? h.data.title ?? ""}
              fetchpriority={i === 0 ? "high" : undefined}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
              draggable="false"
            />
          ))
        }
        <!-- 左右点击区(整块半屏),箭头仅悬停浮现 -->
        {
          heroCount > 1 && (
            <>
              <button
                id="hero-left"
                type="button"
                aria-label="上一张"
                class="absolute inset-y-0 left-0 w-1/2 cursor-pointer"
              ></button>
              <button
                id="hero-right"
                type="button"
                aria-label="下一张"
                class="absolute inset-y-0 right-0 w-1/2 cursor-pointer"
              ></button>
              <button
                id="hero-prev"
                type="button"
                aria-label="上一张"
                class="absolute left-5 top-1/2 -translate-y-1/2 p-3 text-2xl text-white/80 opacity-50 transition-opacity duration-300 hover:opacity-100"
              >
                &larr;
              </button>
              <button
                id="hero-next"
                type="button"
                aria-label="下一张"
                class="absolute right-5 top-1/2 -translate-y-1/2 p-3 text-2xl text-white/80 opacity-50 transition-opacity duration-300 hover:opacity-100"
              >
                &rarr;
              </button>
            </>
          )
        }
      </section>
    )
  }

  <!-- 精选墙:12 张,保留原始比例,宽松间距 -->
  <section class="mx-auto w-full max-w-5xl px-5 pt-16 pb-24">
    <div class="columns-1 gap-10 sm:columns-2 lg:columns-3">
      {
        picks.map((p) => (
          <button
            class="lightbox-trigger glow-card group mb-10 block w-full break-inside-avoid bg-neutral-100 text-left dark:bg-neutral-900"
            data-big={cloudinaryUrl(p.data.filename, 1600)}
            aria-label="放大查看照片"
          >
            <img
              src={cloudinaryUrl(p.data.filename, 1200)}
              alt={p.data.alt ?? p.data.title ?? ""}
              loading="lazy"
              decoding="async"
              class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            />
          </button>
        ))
      }
    </div>
  </section>

  <Lightbox photos={[]} />
</BaseLayout>

<script>
  // Hero 轮播:点击左/右半区淡入淡出切换(纯 JS;featured 只有 1 张时自动无操作)
  ;(function () {
    const slides = Array.from(document.querySelectorAll(".hero-slide"));
    if (slides.length < 2) return;
    let cur = 0;
    function show(i) {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle("opacity-100", k === cur);
        s.classList.toggle("opacity-0", k !== cur);
      });
      // 预加载左右相邻两张,切换即现
      [1, -1].forEach((d) => {
        const img = new Image();
        img.src = slides[(cur + d + slides.length) % slides.length].src;
      });
    }
    function step(d) {
      show(cur + d);
    }
    document.getElementById("hero-left")?.addEventListener("click", () => step(-1));
    document.getElementById("hero-right")?.addEventListener("click", () => step(1));
    document.getElementById("hero-prev")?.addEventListener("click", () => step(-1));
    document.getElementById("hero-next")?.addEventListener("click", () => step(1));
  })();

  // 精选墙悬停光晕:光斑跟随鼠标(样式见 global.css .glow-card)
  ;(function () {
    document.querySelectorAll(".glow-card").forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - r.left}px`);
        card.style.setProperty("--my", `${e.clientY - r.top}px`);
      });
    });
  })();
</script>
