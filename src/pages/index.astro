---
// 首页:项目照片墙 —— 每个项目精选 1 张代表图(统一比例),每 3 天自动轮换到该项目另一张。
//
// 轮换机制(纯前端、确定性,换图无需重新部署):
//   把时间按 3 天切成一个个"桶",同一桶内所有访客看到相同结果;
//   用 (桶号|项目id) 做简单哈希,对项目照片数取模 → 本轮展示第几张。
//   构建时按构建时刻的桶算一张先写进 HTML 首屏(无 JS 也可见图),
//   页面加载后内联脚本再用访问者当前时间重算一次,桶变了就换图,
//   并同步卡片的 data-big / data-caption,保证点击放大的是墙面上当前那张。
//   改 frontmatter 里的 pickIndex 时,必须同步改页面底部内联脚本里的同款算法。
//
// 点击行为:只放大当前这张(单图模式,不走多图浏览)—— Lightbox 见组件内 data-big 说明。
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import { cloudinaryUrl } from "../lib/images";

const BUCKET_MS = 3 * 86400000; // 3 天一个轮换周期

// 确定性选图:同一(桶, 项目)永远选同一张;哈希用 djb2(与内联脚本一致)
function pickIndex(slug: string, count: number): number {
  const bucket = Math.floor(Date.now() / BUCKET_MS);
  let h = 5381;
  const key = `${bucket}|${slug}`;
  for (let i = 0; i < key.length; i++) h = ((h << 5) + h + key.charCodeAt(i)) >>> 0;
  return h % count;
}

const allPhotos = (await getCollection("photos")).sort((a, b) =>
  (b.data.date ?? "").localeCompare(a.data.date ?? ""),
);

// 每个项目的照片(时间倒序,与项目页一致),只保留有照片的项目,新的项目排前面
const cards = (await getCollection("projects"))
  .map((p) => ({ project: p, photos: allPhotos.filter((ph) => ph.data.project === p.id) }))
  .filter((x) => x.photos.length > 0)
  .sort((a, b) => (b.photos[0].data.date ?? "").localeCompare(a.photos[0].data.date ?? ""))
  .map(({ project, photos }) => {
    const pid = project.id;
    const title = project.data.title;
    const thumbs = photos.map((p) => cloudinaryUrl(p.data.filename, 800)); // 墙面缩略图
    const bigs = photos.map((p) => cloudinaryUrl(p.data.filename, 1600)); // 点击放大
    const titles = photos.map((p) => p.data.title ?? ""); // 与上面两张同序
    const pick = pickIndex(pid, photos.length); // 首屏选图(构建时刻的桶)
    return { pid, title, count: photos.length, pick, thumbs, bigs, titles };
  });
---

<BaseLayout>
  <section class="mx-auto w-full max-w-5xl px-5">
    <div class="mx-auto max-w-xl pb-16 pt-8 text-center">
      <p class="leading-relaxed text-mist">
        用照片记录走过的路、看过的风景和日常的瞬间。
      </p>
      <p class="mt-3 text-xs tracking-wide text-mist/70">
        每个项目精选 1 张 · 每 3 天自动换一张 · 点击照片可放大浏览
      </p>
    </div>

    <div class="grid grid-cols-1 gap-x-8 gap-y-10 pb-24 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((c) => (
          <button
            class="lightbox-trigger group block text-left"
            data-project={c.pid}
            data-pick={c.pick}
            data-big={c.bigs[c.pick]}
            data-caption={c.titles[c.pick]}
            aria-label={`放大查看「${c.title}」代表照`}
          >
            <div class="overflow-hidden bg-neutral-100">
              <img
                src={c.thumbs[c.pick]}
                alt={c.title}
                loading="lazy"
                decoding="async"
                class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              />
            </div>
            <span
              class="mt-3 flex items-baseline gap-2 text-sm opacity-0 transition-opacity duration-300 group-hover:opacity-100"
            >
              <span class="text-ink">{c.title}</span>
              <span class="text-xs text-mist">{c.count} 张</span>
            </span>
          </button>
        ))
      }
    </div>
  </section>

  <Lightbox photos={[]} />
</BaseLayout>

<script
  define:vars={{
    rotation: cards.map((c) => ({ id: c.pid, thumbs: c.thumbs, bigs: c.bigs, titles: c.titles })),
  }}
>
  // 3 天轮换:用访问者当前时间重算选图,与 frontmatter pickIndex 算法完全一致(纯 JS)。
  // 桶没变 → 与首屏 data-pick 相同,什么都不做;桶变了 → 换掉墙面的缩略图,
  // 并同步 data-big / data-caption,保证点击放大的是墙面上当前展示的这一张。
  ;(function () {
    const items = rotation;
    const bucket = Math.floor(Date.now() / (3 * 86400000));
    for (const item of items) {
      let h = 5381;
      const key = bucket + "|" + item.id;
      for (let i = 0; i < key.length; i++) h = ((h << 5) + h + key.charCodeAt(i)) >>> 0;
      const pick = h % item.thumbs.length;
      const card = document.querySelector(
        '.lightbox-trigger[data-project="' + item.id + '"]',
      );
      if (!card || Number(card.dataset.pick) === pick) continue; // 没轮到换,保持首屏
      const img = card.querySelector("img");
      if (img) img.src = item.thumbs[pick];
      card.dataset.big = item.bigs[pick];
      card.dataset.caption = item.titles[pick];
    }
  })();
</script>
