---
// 项目卡片:封面 + 标题 + 拍摄时间/地点(PRD V1.2 项目元素;留空则不显示)
import { cloudinaryUrl } from "../lib/images";

interface Props {
  slug: string;
  title: string;
  coverImage: string;
  date?: string | null;
  location?: string | null;
}

const { slug, title, coverImage, date, location } = Astro.props;
const cover = cloudinaryUrl(coverImage, 1200);
const meta = [date, location].filter(Boolean).join(" · ");
---

<a
  href={`/projects/${slug}/`}
  class="group block"
>
  <div class="overflow-hidden bg-neutral-100 dark:bg-neutral-900">
    <img
      src={cover}
      alt={title}
      loading="lazy"
      decoding="async"
      class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
    />
  </div>
  <h2 class="mt-4 text-lg font-medium dark:text-neutral-100">{title}</h2>
  {
    meta && (
      <p class="mt-1 text-xs tracking-wide text-mist">{meta}</p>
    )
  }
</a>
