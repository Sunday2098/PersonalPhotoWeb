---
// 全屏灯箱(PRD V1.1 §4.4)
// 用法:页面渲染 <Lightbox photos={[{ src, title, exif }]} id="lb-xxx" />,
// 给缩略图加 class="lightbox-trigger" + data-lightbox={灯箱 id}(不带 = 默认实例)+ data-index={i},
// 点击即在 i 处打开灯箱,←/→ 在 photos 数组内切换(项目页等)。
// 若触发器自带 data-big(大图 URL)+ data-caption(标题),则进入"卡片浏览模式"(首页等):
//   放大该卡片当前展示的图,←/→ 在本灯箱所有带 data-big 的卡片之间循环切换。
//   每次显示都即时读取卡片当前的 data-big/data-caption,所以外部换图
//   (如首页 3 天轮换)之后,放大与切换到的仍是墙面上正在显示的那批图。
// 同页可渲染多个实例(id 各不相同);默认实例兼容不带 data-lightbox 的旧触发器。
// src 为 Cloudinary 大图 URL(1600w,由页面传入)

interface ExifInfo {
  camera?: string;
  focalLength?: string;
  iso?: number;
}

interface LightboxPhoto {
  src: string;
  title: string;
  exif?: ExifInfo;
}

interface Props {
  photos: LightboxPhoto[];
  id?: string;
}

const { photos, id = "lightbox" } = Astro.props;
const lbId = id;
---

<div
  id={lbId}
  class="lightbox fixed inset-0 z-50 flex items-center justify-center bg-white"
  role="dialog"
  aria-modal="true"
  aria-label="照片浏览"
  aria-hidden="true"
>
  <img
    class="lb-img max-h-[80vh] max-w-[92vw] select-none bg-neutral-100 object-contain"
    src=""
    alt=""
    draggable="false"
  />
  <p
    class="lb-caption absolute inset-x-0 bottom-8 text-center text-xs tracking-wide text-ink/70"
  ></p>
  <button
    class="lb-prev hidden absolute left-4 top-1/2 -translate-y-1/2 p-3 text-2xl text-ink/60 transition-colors hover:text-ink"
    aria-label="上一张"
  >
    &larr;
  </button>
  <button
    class="lb-next hidden absolute right-4 top-1/2 -translate-y-1/2 p-3 text-2xl text-ink/60 transition-colors hover:text-ink"
    aria-label="下一张"
  >
    &rarr;
  </button>
  <button
    class="lb-close absolute right-5 top-5 p-2 text-2xl text-ink/60 transition-colors hover:text-ink"
    aria-label="关闭"
  >
    &times;
  </button>
</div>

<script define:vars={{ photos, lbId }}>
  // 注意:define:vars 的内联脚本不经过 esbuild,必须写纯 JS(无 TS 注解)。
  // 同页多实例时,define:vars 注入的变量会挤进同一个作用域,因此立刻拷一份局部变量,
  // 后面所有逻辑都只引用局部变量,避免实例之间互相覆盖。
  ;(function () {
    const myPhotos = photos;
    const myId = lbId;

    const box = document.getElementById(myId);
    if (!box) return;
    const img = box.querySelector(".lb-img");
    const caption = box.querySelector(".lb-caption");
    const prevBtn = box.querySelector(".lb-prev");
    const nextBtn = box.querySelector(".lb-next");
    const closeBtn = box.querySelector(".lb-close");

    // 默认实例:兼容不带 data-lightbox 的旧触发器;具名实例只收自己 id 的触发器
    const sel =
      myId === "lightbox"
        ? '.lightbox-trigger[data-lightbox="lightbox"], .lightbox-trigger:not([data-lightbox])'
        : '.lightbox-trigger[data-lightbox="' + myId + '"]';
    const triggers = Array.from(document.querySelectorAll(sel));

    let index = 0; // 数组浏览模式(photos[i])的当前位
    let cardIndex = -1; // 卡片浏览模式(墙面 data-big)的当前卡片位;-1 = 数组模式
    let touchX = 0;

    // 灯箱说明只显示标题(EXIF 信息不对外展示;数据仍保留在 content 里)
    function captionText(p) {
      return p.title ?? "";
    }

    function show(i) {
      index = (i + myPhotos.length) % myPhotos.length;
      img.src = myPhotos[index].src;
      img.alt = myPhotos[index].title ?? "";
      caption.textContent = captionText(myPhotos[index]);
    }

    // 卡片浏览:内容即时读卡片的 data-big / data-caption(点击/切换瞬间取值,
    // 外部换图后仍是墙面上正在显示的那张);←/→ 在卡片之间循环
    function showCard(i) {
      const n = triggers.length;
      if (!n) return;
      cardIndex = ((i % n) + n) % n;
      const el = triggers[cardIndex];
      img.src = el.dataset.big;
      img.alt = el.dataset.caption ?? "";
      caption.textContent = el.dataset.caption ?? "";
    }

    function openCard(el) {
      const i = triggers.indexOf(el);
      if (i < 0) return;
      prevBtn?.classList.remove("hidden");
      nextBtn?.classList.remove("hidden");
      showCard(i);
      openBox();
    }

    function open(i) {
      cardIndex = -1; // 切回数组模式
      prevBtn?.classList.remove("hidden");
      nextBtn?.classList.remove("hidden");
      show(i);
      openBox();
    }

    function openBox() {
      box.classList.add("open");
      box.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function close() {
      box.classList.remove("open");
      box.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    function step(delta) {
      if (cardIndex >= 0) {
        showCard(cardIndex + delta); // 卡片间切换(首页照片墙)
        return;
      }
      show(index + delta); // 数组内切换(项目照片)
    }

    triggers.forEach((el) => {
      el.addEventListener("click", () => {
        if (el.dataset.big) {
          openCard(el); // 首页卡片:放大并从这张开始左右浏览
          return;
        }
        const i = Number(el.dataset.index ?? 0);
        if (myPhotos[i]) open(i);
      });
    });

    prevBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      step(-1);
    });
    nextBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      step(1);
    });
    closeBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      close();
    });

    // 点击背景关闭
    box.addEventListener("click", (e) => {
      if (e.target === box) close();
    });

    // 键盘(同一时刻最多一个灯箱处于 open)
    document.addEventListener("keydown", (e) => {
      if (!box.classList.contains("open")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });

    // 触屏滑动切换
    box.addEventListener("touchstart", (e) => {
      touchX = e.changedTouches[0].clientX;
    });
    box.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
    });
  })();
</script>
