---
// 全屏灯箱(PRD V1.2 §4.4)
// 用法:页面渲染 <Lightbox photos={[{ src, title, exif }]} id="lb-xxx" />,
// 给缩略图加 class="lightbox-trigger" + data-lightbox={灯箱 id}(不带 = 默认实例)+ data-index={i},
// 点击即在 i 处打开灯箱,←/→ 在 photos 数组内切换(项目页)。
// 若触发器自带 data-big(大图 URL),则进入"卡片浏览模式"(首页精选墙):
//   放大该卡片当前展示的图,←/→ 在本灯箱所有带 data-big 的卡片之间循环。
//   每次显示即时读取卡片当前的 data-big,外部换图后仍与墙面一致。
// 交互(PRD V1.2 §4.4):深色背景;左上角显示 当前序号/总数;右上角 全屏/放大/关闭;
//   左右箭头在图片外(桌面端在视口两侧,移动端在底部控制条);大图加载显示占位;
//   ESC/点击图片以外区域关闭;触屏左右滑动切换;图片下方显示 标题 · 拍摄设备(留空则不显示)。
// 同页可渲染多个实例(id 各不相同);默认实例兼容不带 data-lightbox 的旧触发器。

// 灯箱只渲染拍摄设备(camera)。焦段/光圈/ISO 在内容 frontmatter 里仍然保留,
// 只是按需求不在放大视图显示 —— 日后要放回来,从这里加回字段即可。
interface ExifInfo {
  camera?: string;
}

interface LightboxPhoto {
  src: string;
  title: string;
  alt?: string;
  exif?: ExifInfo;
}

interface Props {
  photos: LightboxPhoto[];
  id?: string;
}

const { photos, id = "lightbox" } = Astro.props;
const lbId = id;
---

<div
  id={lbId}
  class="lightbox fixed inset-0 z-50 bg-black/95"
  role="dialog"
  aria-modal="true"
  aria-label="照片浏览"
  aria-hidden="true"
>
  <!-- 顶部栏:左计数器,右 全屏/放大/关闭(z-10 防止被全屏图片区挡住点击) -->
  <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-5 py-4 sm:px-6">
    <span class="lb-counter text-xs tracking-widest text-white/70"></span>
    <div class="flex items-center gap-4">
      <button
        class="lb-fullscreen p-1 text-white/70 transition-colors hover:text-white"
        aria-label="全屏"
        title="全屏"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9V4h5m6 0h5v5m0 6v5h-5m-6 0H4v-5" />
        </svg>
      </button>
      <button
        class="lb-zoom p-1 text-white/70 transition-colors hover:text-white"
        aria-label="放大"
        title="放大 / 还原"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.3-4.3M11 8v6M8 11h6" />
        </svg>
      </button>
      <button
        class="lb-close p-1 text-white/70 transition-colors hover:text-white"
        aria-label="关闭"
        title="关闭"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- 图片区(桌面端两侧留出箭头位,箭头不在图片里;移动端图片占满宽) -->
  <div class="lb-stage absolute inset-0 flex flex-col items-center justify-center gap-4">
    <img
      class="lb-img max-h-[calc(100vh-9rem)] max-w-full select-none object-contain transition-transform duration-300 sm:max-w-[calc(100vw-8rem)]"
      src=""
      alt=""
      draggable="false"
    />
    <!-- 图片标注:标题 + 拍摄设备。无内容时由 .lb-caption:empty 隐藏 -->
    <p class="lb-caption mx-6 max-w-2xl text-center text-xs leading-relaxed tracking-[0.15em] text-white/50"></p>
  </div>

  <!-- 大图加载占位(PRD §4.4 验收:大图加载时显示占位图;纯视觉层,不拦截点击) -->
  <div class="lb-loading pointer-events-none absolute inset-0 flex items-center justify-center">
    <div class="lb-spinner"></div>
  </div>

  <!-- 桌面端箭头:固定在视口两侧,图片之外(图标语言与首屏一致:1.5 描边人字形) -->
  <button
    class="lb-prev absolute left-0 top-1/2 z-10 hidden -translate-y-1/2 p-4 text-white/70 transition-colors hover:text-white sm:block"
    aria-label="上一张"
  >
    <svg class="block h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 6-6 6 6 6" />
    </svg>
  </button>
  <button
    class="lb-next absolute right-0 top-1/2 z-10 hidden -translate-y-1/2 p-4 text-white/70 transition-colors hover:text-white sm:block"
    aria-label="下一张"
  >
    <svg class="block h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 6 6 6-6 6" />
    </svg>
  </button>

  <!-- 移动端底部控制条:上一张 / 计数 / 下一张(手机适配) -->
  <div class="lb-mobile-bar absolute inset-x-0 bottom-0 z-10 flex items-center justify-between px-6 pb-6 sm:hidden">
    <button class="lb-prev-m p-3 text-white/80" aria-label="上一张">
      <svg class="block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 6-6 6 6 6" />
      </svg>
    </button>
    <span class="lb-counter-m text-xs tracking-widest text-white/70"></span>
    <button class="lb-next-m p-3 text-white/80" aria-label="下一张">
      <svg class="block h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 6 6 6-6 6" />
      </svg>
    </button>
  </div>
</div>

<script define:vars={{ photos, lbId }}>
  // 注意:define:vars 的内联脚本不经过 esbuild,必须写纯 JS(无 TS 注解)。
  // 同页多实例时,define:vars 注入的变量会挤进同一个作用域,因此立刻拷一份局部变量,
  // 后面所有逻辑都只引用局部变量,避免实例之间互相覆盖。
  ;(function () {
    const myPhotos = photos;
    const myId = lbId;

    const box = document.getElementById(myId);
    if (!box) return;
    const stage = box.querySelector(".lb-stage");
    const img = box.querySelector(".lb-img");
    const caption = box.querySelector(".lb-caption");
    const counter = box.querySelector(".lb-counter");
    const counterM = box.querySelector(".lb-counter-m");
    const loading = box.querySelector(".lb-loading");
    const prevBtn = box.querySelector(".lb-prev");
    const nextBtn = box.querySelector(".lb-next");
    const prevBtnM = box.querySelector(".lb-prev-m");
    const nextBtnM = box.querySelector(".lb-next-m");
    const zoomBtn = box.querySelector(".lb-zoom");
    const fullscreenBtn = box.querySelector(".lb-fullscreen");
    const closeBtn = box.querySelector(".lb-close");

    // 默认实例:兼容不带 data-lightbox 的旧触发器;具名实例只收自己 id 的触发器
    const sel =
      myId === "lightbox"
        ? '.lightbox-trigger[data-lightbox="lightbox"], .lightbox-trigger:not([data-lightbox])'
        : '.lightbox-trigger[data-lightbox="' + myId + '"]';
    const triggers = Array.from(document.querySelectorAll(sel));

    let index = 0; // 数组浏览模式(photos[i])的当前位
    let cardIndex = -1; // 卡片浏览模式(带 data-big 的触发器)当前位;-1 = 数组模式
    let touchX = 0;

    function total() {
      return cardIndex >= 0 ? triggers.length : myPhotos.length;
    }

    function updateNav() {
      const n = total();
      const cur = (cardIndex >= 0 ? cardIndex : index) + 1;
      counter.textContent = n > 1 ? cur + " / " + n : "";
      counterM.textContent = n > 1 ? cur + " / " + n : "";
      const show = n > 1;
      prevBtn?.classList.toggle("sm:hidden", !show);
      nextBtn?.classList.toggle("sm:hidden", !show);
      const bar = box.querySelector(".lb-mobile-bar");
      if (bar) bar.classList.toggle("hidden", !show);
    }

    // 加载占位:换图时显示 spinner,大图 load 后隐藏
    img.addEventListener("load", () => {
      loading.style.opacity = "0";
    });
    function setLoading() {
      loading.style.opacity = "1";
      img.classList.remove("lb-zoomed"); // 换图时还原放大
    }

    // 图片标注:标题 · 拍摄设备(逐项过滤空值)。
    // 焦段/光圈/ISO 按需求不再展示;数据仍在内容 frontmatter 里,没有删。
    function captionOf(photo) {
      if (!photo) return "";
      const exif = photo.exif || {};
      return [photo.title, exif.camera].filter(Boolean).join(" · ");
    }

    // 标注留空时 .lb-caption:empty 会自动隐藏;alt 用于无障碍
    function setMeta(photo, alt) {
      caption.textContent = captionOf(photo);
      img.alt = alt || "";
    }

    function show(i) {
      index = (i + myPhotos.length) % myPhotos.length;
      const photo = myPhotos[index];
      setLoading();
      img.src = photo.src;
      setMeta(photo, photo.alt || photo.title);
      updateNav();
    }

    // 卡片浏览:内容即时读卡片的 data-big(点击/切换瞬间取值)
    function showCard(i) {
      const n = triggers.length;
      if (!n) return;
      cardIndex = ((i % n) + n) % n;
      const el = triggers[cardIndex];
      setLoading();
      img.src = el.dataset.big;
      // 精选墙的卡片没有标题/EXIF,标注留空;无障碍名称取卡片自身图片的 alt
      setMeta(null, el.querySelector("img")?.alt || "");
      updateNav();
    }

    function openCard(el) {
      const i = triggers.indexOf(el);
      if (i < 0) return;
      showCard(i);
      openBox();
    }

    function open(i) {
      cardIndex = -1; // 切回数组模式
      show(i);
      openBox();
    }

    function openBox() {
      box.classList.add("open");
      box.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function close() {
      box.classList.remove("open");
      box.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (document.fullscreenElement) {
        const p = document.exitFullscreen();
        if (p && p.catch) p.catch(() => {});
      }
      img.classList.remove("lb-zoomed");
    }

    function step(delta) {
      if (cardIndex >= 0) {
        showCard(cardIndex + delta); // 卡片间切换(首页精选墙)
        return;
      }
      show(index + delta); // 数组内切换(项目照片)
    }

    triggers.forEach((el) => {
      el.addEventListener("click", () => {
        if (el.dataset.big) {
          openCard(el);
          return;
        }
        const i = Number(el.dataset.index ?? 0);
        if (myPhotos[i]) open(i);
      });
    });

    prevBtn?.addEventListener("click", (e) => { e.stopPropagation(); step(-1); });
    nextBtn?.addEventListener("click", (e) => { e.stopPropagation(); step(1); });
    prevBtnM?.addEventListener("click", (e) => { e.stopPropagation(); step(-1); });
    nextBtnM?.addEventListener("click", (e) => { e.stopPropagation(); step(1); });
    closeBtn?.addEventListener("click", (e) => { e.stopPropagation(); close(); });

    // 放大:1x ↔ 2x(样式见 global.css .lb-zoomed)
    zoomBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      img.classList.toggle("lb-zoomed");
    });

    // 全屏(浏览器 Fullscreen API;iOS Safari 等不支持时静默无操作)
    fullscreenBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (document.fullscreenElement) {
        const p = document.exitFullscreen();
        if (p && p.catch) p.catch(() => {});
        return;
      }
      const p = box.requestFullscreen?.();
      if (p && p.catch) p.catch(() => {});
    });

    // 点击图片以外区域关闭(图片本身和顶部按钮点击不关闭)
    box.addEventListener("click", (e) => {
      if (e.target === box || e.target === stage) close();
    });

    // 键盘(同一时刻最多一个灯箱处于 open)
    document.addEventListener("keydown", (e) => {
      if (!box.classList.contains("open")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });

    // 触屏滑动切换
    box.addEventListener("touchstart", (e) => {
      touchX = e.changedTouches[0].clientX;
    });
    box.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);
    });
  })();
</script>
